# ---------------------------------------------------------------------------
# Company news component - configuration
# Copy to .env and fill in. Every value below has a working default except
# FINNHUB_API_KEY, which the service needs to fetch US-listed news.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
# Points at the Postgres that docker compose starts. Override to use your own.
DATABASE_URL=postgres://news:news@localhost:5433/newsdb
DATABASE_POOL_MAX=10

# --- HTTP ------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated origins, or * for any. Only affects browser callers.
CORS_ORIGIN=*

# Optional bearer token protecting POST /v1/fetch, the only endpoint that does
# real outbound work. Leave empty behind a private-network gateway. Set it if
# the port is reachable more widely: an unauthenticated caller can otherwise
# start a 26-minute run and consume the whole provider budget.
#   curl -X POST localhost:8080/v1/fetch -H "authorization: Bearer $API_AUTH_TOKEN"
API_AUTH_TOKEN=

# --- Providers -------------------------------------------------------------
# Required. Free tier: https://finnhub.io/register
FINNHUB_API_KEY=

# Optional. Entity-tagged global news (80+ markets, 30+ languages). This is
# what closes the international and OTC gaps the free stack cannot reach.
# Free tier at https://www.marketaux.com is enough to evaluate coverage.
MARKETAUX_API_KEY=
MARKETAUX_RATE_LIMIT_PER_MIN=60
# Page size. Free tier caps at 3, Basic 20, Standard 50, Pro 100.
MARKETAUX_PAGE_SIZE=50
MARKETAUX_LANGUAGES=en

# Provider preference, highest first. The ingest walks this list and uses the
# first provider that declares it can serve a given company.
#
# Finnhub is first because it is free, ticker-native and strong on US
# exchanges (87% hit rate). Marketaux picks up what it cannot reach - non-US
# listings and thin OTC lines. Once Marketaux is proven on your catalogue,
# google_news_rss can be dropped: it is name-matched, and it is the source of
# every misattribution the relevance layer has to filter out.
# google_news_rss is deliberately NOT in the default order. It returns
# news.google.com interstitial links whose real article address cannot be
# recovered - they fail when a reader clicks them and can never carry an
# image. Add it back only if you would rather have unopenable headlines than
# no headline.
NEWS_PROVIDER_ORDER=finnhub,marketaux

# Per-provider request budget (requests per minute). Finnhub's free tier is 60.
FINNHUB_RATE_LIMIT_PER_MIN=55
GOOGLE_NEWS_RATE_LIMIT_PER_MIN=40

# Optional. Free key raises OpenFIGI from 25 to 250 requests/minute and the
# batch size from 10 to 100 jobs, which takes listing resolution from ~25min
# to ~2min for the full catalogue. https://www.openfigi.com/api
OPENFIGI_API_KEY=

# --- Ingest behaviour ------------------------------------------------------
# How far back to look when a company has never been fetched before.
# How far back to look the FIRST time a company is fetched. 90, not 7: asking
# for one week makes a company with a normal news cadence look silent. Measured
# on companies that returned nothing over 7 days - AvalonBay 0 -> 89 articles,
# Church & Dwight 2 -> 88 - the window, not coverage, was the limit.
# Subsequent runs use since-last-run, so this cost is paid once.
INGEST_INITIAL_LOOKBACK_DAYS=90

# Newest-N articles kept on a company's FIRST fetch only. A 90-day backfill
# returns ~130 for an active company and each costs a link resolution, which
# dominates run time. Incremental runs are never capped: a busy company can
# publish 100+ stories in a day, and since the fetch state advances regardless,
# anything dropped would be outside the next window permanently.
INGEST_MAX_ARTICLES_PER_COMPANY=25
# Overlap re-fetched on every incremental run, so nothing falls through a gap
# between runs. Deduplication makes the overlap free.
INGEST_OVERLAP_HOURS=6
INGEST_CONCURRENCY=6
INGEST_MAX_RETRIES=3

# Outer guard against a provider that never returns at all. It must be well
# above the per-request timeout, because a company's elapsed time also includes
# waiting for our own rate-limiter token and any retries - and Google News
# issues up to three queries per company. Setting this too low makes the
# primary provider "fail" while it is merely queued, silently downgrading the
# company to a weaker source. Real per-request timeouts are enforced in the
# HTTP layer at 15s.
INGEST_COMPANY_TIMEOUT_MS=120000

# Cap on companies per run. 0 = the whole catalogue.
INGEST_MAX_COMPANIES=0

# --- Scheduling ------------------------------------------------------------
# Off by default: the recommended deployment runs `npm run ingest` from an
# external scheduler so a crashed API process cannot silently skip a day.
# Set true to run the in-process daily timer instead.
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 6 * * *

# Optional. Comma-separated hosts whose links and images are dropped at ingest,
# for publishers that serve nobody - not ones that merely block automated
# clients. Defaults to chartmill.com, which refuses the connection outright
# (no HTTP status at all, even from a browser).
#
# LEAVE THIS COMMENTED OUT to keep the default. Setting it to an empty value
# is meaningful and different: it disables the filter entirely.
#DEAD_ARTICLE_HOSTS=
