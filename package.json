{
  "name": "news-component",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone company-news backend: resolves listings across exchanges and keeps a deduplicated news feed per company.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/api/server.js",
    "dev": "tsx watch src/api/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "catalogue:load": "tsx scripts/load-catalogue.ts",
    "resolve": "tsx scripts/resolve-listings.ts",
    "ingest": "tsx scripts/run-ingest.ts",
    "setup": "tsx scripts/setup.ts",
    "coverage:probe": "tsx scripts/coverage-probe.ts",
    "export:listings": "tsx scripts/export-listings.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ingest:market": "tsx scripts/run-market-news.ts",
    "metrics": "tsx scripts/report-metrics.ts",
    "export:openapi": "tsx scripts/export-openapi.ts",
    "evaluate": "tsx scripts/evaluate-provider.ts",
    "resolve:links": "tsx scripts/resolve-links.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.1",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
